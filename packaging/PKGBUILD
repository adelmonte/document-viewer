# Maintainer: adelmonte
pkgname=document-viewer
pkgver=0.1.2
pkgrel=1
pkgdesc='Document viewer for PDF, DjVu, DVI, TIFF, images and comic books, written in pure Rust'
arch=('x86_64')
url='https://github.com/adelmonte/document-viewer'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'libglvnd' 'libxkbcommon' 'wayland')
optdepends=('texlive-binextra: kpsewhich, to find fonts for DVI files'
            'xdg-desktop-portal: file dialogs and printing'
            'cups: printing without the portal (lp)')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('dd69bf004770199392f3867c16472b32cb3e59aa4ef22558e52704820637fb25')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  local bin=target/${CARGO_BUILD_TARGET:-.}/release
  install -Dm755 "$bin/document-viewer" "$pkgdir/usr/bin/document-viewer"
  install -Dm755 "$bin/document-viewer-thumbnailer" "$pkgdir/usr/bin/document-viewer-thumbnailer"
  install -Dm644 data/document-viewer.desktop "$pkgdir/usr/share/applications/document-viewer.desktop"
  install -Dm644 data/document-viewer.thumbnailer "$pkgdir/usr/share/thumbnailers/document-viewer.thumbnailer"
  install -Dm644 data/document-viewer.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/document-viewer.svg"
  install -Dm644 data/document-viewer-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/document-viewer-symbolic.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
